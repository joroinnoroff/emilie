# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Write token (Editor+) — required to save shop inquiries into Sanity Studio
SANITY_API_WRITE_TOKEN=

# Inquiry email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_TO_EMAIL=
CONTACT_EMAIL=

# Vercel Blob — contact-form attachments (Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Stripe test keys — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Canonical site URL — must match production domain for OG/Twitter cards
# (wrong host makes crawlers fetch the image from elsewhere)
NEXT_PUBLIC_SITE_URL=https://www.emiliewlien.no

# Bring Shipping Guide + Pickup Point (Mybring)
# https://developer.bring.com/api/testing/
BRING_API_UID=
BRING_API_KEY=
BRING_CUSTOMER_NUMBER=5
BRING_FROM_POSTAL_CODE=0150
BRING_CLIENT_URL=http://localhost:3000
BRING_NOK_TO_EUR=0.085
