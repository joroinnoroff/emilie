# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Write token (Editor+) — optional, e.g. marking works sold
SANITY_API_WRITE_TOKEN=

# Vercel Blob — contact-form attachments (Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Stripe test keys — https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Optional site URL for Stripe redirects in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bring Shipping Guide + Pickup Point (Mybring)
# https://developer.bring.com/api/testing/
BRING_API_UID=
BRING_API_KEY=
BRING_CUSTOMER_NUMBER=5
BRING_FROM_POSTAL_CODE=0150
BRING_CLIENT_URL=http://localhost:3000
BRING_NOK_TO_EUR=0.085
